{
    "dx": 2e-3,
    "dy": 2e-3,
    "dt": 1e-4,
    "nx": 3,
    "ny": 3,
    "nt": 20,
    "density": 1000,
    "sampling_rate": 5,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,
    "write_smoke":         true,

    "folder":   "results",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "boundary",
            "val": 1.0,
            "x1": "0",
            "y1": "0",
            "x2": "0",
            "y2": "ny"
        }
    },
   "smoke": {
        "rectangle": {
            "condition": "initial",
            "val": 1.0,
            "x1": "1",
            "y1": "1",
            "x2": "1",
            "y2": "1"
        }
   },
    
   "solver": {
        "type": "gauss_seidel",
        "max_iterations": 5000,
        "tolerance": 1e-1
}
}
