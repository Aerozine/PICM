{
    "dx": 2e-3,
    "dy": 2e-3,
    "dt": 0.01,
    "nx": 500,
    "ny": 300,
    "nt": 50,
    "density": 1000,
    "sampling_rate": 5,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,
    "write_smoke":         true,

    "folder":   "results",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "boundary",
            "val": 0.5,
            "x1": "0",
            "y1": "ny/2",
            "x2": "1",
            "y2": "ny-2"
        }
    },
    "pressure": {
        "rectangle": {
            "condition": "boundary",
            "val": 0,
            "x1": "nx-1",
            "y1": "0",
            "x2": "nx",
            "y2": "ny-1"
        }
    },
    "solid": {
        "rectangle": [
            { "x1": 0,      "y1": 0,      "x2": "nx-1", "y2": 0      },
            { "x1": 0,      "y1": "ny-1", "x2": "nx-1", "y2": "ny-1" }
        ]
    },
   "smoke": {
        "rectangle": {
            "condition":"boundary",
            "val": 1,
            "x1": "0",
            "y1": "0",
            "x2": "1",
            "y2": "ny-1"
        }
   },

    "solver": {
  "type": "red_black_gauss_seidel",
    "max_iterations": 5000,
    "tolerance": 5e-2
}
}

