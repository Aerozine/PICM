{
    "dx": 1e-3,
    "dy": 1e-3,
    "dt": 1e-2,
    "nx": 150,
    "ny": 80,
    "nt": 150,
    "density": 1000,
    "sampling_rate": 1,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,

    "folder":   "results",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "boundary",
            "val": 0.5,
            "x1": "1",
            "y1": "3",
            "x2": "2",
            "y2": "ny-2"
        }
    },

    "solid": {
        "cylinder": {
            "x": "nx/5",
            "y": "ny/2",
            "r": "ny/15"
        },
        "rectangle":[{
            "x1": "0",
            "y1": "0",
            "x2": "nx+1",
            "y2": "2"
        },
        {
            "x1": "0",
            "y1": "ny-1",
            "x2": "nx+1",
            "y2": "ny+1"
        }]
    },

    "air": {
        "rectangle": {
            "condition": "boundary",
            "val": 0,
            "x1": "nx+1",
            "y1": "0",
            "x2": "nx+1",
            "y2": "ny+1"
        }
    },

    "solver": {
  "type": "red_black_gauss_seidel",
    "max_iterations": 5e3,
    "tolerance": 5e-1
}
}

