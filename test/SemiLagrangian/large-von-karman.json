{
    "dx": 2e-3,
    "dy": 2e-3,
    "dt": 1e-2,
    "nx": 500,
    "ny": 300,
    "nt": 1000,
    "density": 1000,
    "sampling_rate": 5,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,
    "write_smoke":         true,

    "folder":   "results",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "boundary",
            "val": 0.3,
            "x1": "0",
            "y1": "0",
            "x2": "0",
            "y2": "ny-1"
        }
    },

    "air": {
        "rectangle": {
            "condition": "boundary",
            "val": 0,
            "x1": "nx-1",
            "y1": "0",
            "x2": "nx-1",
            "y2": "ny-1"
        }
    },

    "solid": {
        "cylinder": {
            "x": "nx/8",
            "y": "ny/2",
            "r": "ny/12"
        },

        "rectangle":[{
            "x1": "0",
            "y1": "ny-1",
            "x2": "nx-1",
            "y2": "ny-2"
        },
        {
            "x1": "0",
            "y1": "0",
            "x2": "nx-1",
            "y2": "1"
        }]
    },

    "smoke": {
        "rectangle": {
            "condition":"boundary",
            "val": 0.5,
            "x1": "0",
            "y1": "0",
            "x2": "0",
            "y2": "ny-1"
        }
    },


    "solver": {
  "type": "red_black_gauss_seidel",
    "max_iterations": 1e5,
    "tolerance": 5e-1
}
}