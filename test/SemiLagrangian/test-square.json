{
    "dx": 1e-3,
    "dy": 1e-3,
    "dt": 1e-4,
    "nx": 80,
    "ny": 80,
    "nt": 400,
    "density": 1000,
    "sampling_rate": 1,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,

    "folder":   "results/SL/square",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "initial",
            "val": 10.0,
            "x1": "nx/2-7",
            "y1": "ny/2-7",
            "x2": "nx/2+7",
            "y2": "ny/2+7"
        }
    },
    "solid": {
        "rectangle": [
            { "x1": 0,      "y1": 0,      "x2": "nx-1", "y2": 0      },
            { "x1": 0,      "y1": "ny-1", "x2": "nx-1", "y2": "ny-1" },
            { "x1": 0,      "y1": 0,      "x2": 0,      "y2": "ny-1" },
            { "x1": "nx-1", "y1": 0,      "x2": "nx-1", "y2": "ny-1" }
        ]
   },

"solver": {  
    "type": "red_black_gauss_seidel",
    "max_iterations": 5000,
    "tolerance": 1e-2
}
}
