{
    "dx": 2e-3,
    "dy": 2e-3,
    "dt": 0.01,
    "nx": 200,
    "ny": 70,
    "nt": 500,
    "density": 1000,
    "sampling_rate": 1,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,
    "write_smoke":         true,

    "folder":   "results",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "boundary",
            "val": 0.5,
            "x1": "0",
            "y1": "0",
            "x2": "1",
            "y2": "ny"
        }
    },

    "pressure": {
        "rectangle": {
            "condition": "boundary",
            "val": 0,
            "x1": "nx-1",
            "y1": "0",
            "x2": "nx",
            "y2": "ny"
        }
    },

    "solid": {
        "cylinder": {
            "x": "125",
            "y": "ny/2",
            "r": 10
        },

        "rectangle":[{
            "x1": "0",
            "y1": "ny-1",
            "x2": "nx-1",
            "y2": "ny-5"
        },
        {
            "x1": "0",
            "y1": "0",
            "x2": "nx-1",
            "y2": "5"
        }]
    },
   "smoke": {
        "rectangle": {
            "condition":"boundary",
            "val": 1,
            "x1": "0",
            "y1": "0",
            "x2": "0",
            "y2": "ny"
        }
   },

    "solver": {
  "type": "red_black_gauss_seidel",
    "max_iterations": 1e4,
    "tolerance": 1e-2
}
}
