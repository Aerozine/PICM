{
    "dx": 0.007,
    "dy": 0.007,
    "dt": 0.001,
    "nx": 20,
    "ny": 20,
    "nt": 500,
    "ppcx": 10,
    "ppcy": 10,
    "density": 1000,
    "sampling_rate": 2,
    "write_u": true,
    "write_v": true,
    "write_p": true,
    "write_div": true,
    "write_norm_velocity": true,
    "write_smoke": true,
    "write_particles": true,
    "folder": "results/PIC/surfaceTension/square",
    "filename": "simulation",

    "fluid": {
        "rectangle":{
            "x1": "4*nx/10",
            "y1": "4*ny/10",
            "x2": "6*nx/10",
            "y2": "6*ny/10"
        }
    },

    "solid": {
        "rectangle":[{
            "x1": "0",
            "y1": "0",
            "x2": "nx+1",
            "y2": "0"
        },
        {
            "x1": "0",
            "y1": "ny+1",
            "x2": "nx+1",
            "y2": "ny+1"
        },
        {
            "x1": "0",
            "y1": "0",
            "x2": "0",
            "y2": "ny+1"
        },
        {
            "x1": "nx+1",
            "y1": "0",
            "x2": "nx+1",
            "y2": "ny+1"
        }]
    },


    "solver": {
        "type": "red_black_gauss_seidel",
        "max_iterations": 1e5,
        "tolerance": 1e-2
    },
    "method": "pic",
    "freeSurface": "yes",
    "gravity": 0.0,
    "refill": false,
    "surfaceTension": true,
    "gamma": 0.073
