{
    "dx": 2e-3,
    "dy": 2e-3,
    "dt": 0.01,
    "nx": 20,
    "ny": 20,
    "nt": 50,    
    "ppcx": 2,
    "ppcy": 2,
    "density": 1000,
    "sampling_rate": 5,

    "write_u":             true,
    "write_v":             true,
    "write_p":             true,
    "write_div":           true,
    "write_norm_velocity": true,
    "write_smoke":         true,
    "write_particles":         true,

    "folder":   "results",
    "filename": "simulation",

    "velocityu": {
        "rectangle": {
            "condition": "boundary",
            "val": 0.0000001,
            "x1": "1",
            "y1": "ny/2",
            "x2": "2",
            "y2": "ny-2"
        }
    },
    "solid": {
       "rectangle": [
            { "x1": 0,      "y1": 0,      "x2": "nx-1", "y2": 0      },
            { "x1": 0,      "y1": "ny-1", "x2": "nx-1", "y2": "ny-1" }
        ]
    },
   "solver": {
  "type": "red_black_gauss_seidel",
    "max_iterations": 5000,
    "tolerance": 1e-2
}
}


