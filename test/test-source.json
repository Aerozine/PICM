            "condition": "boundary",
            "val": 0,
            "x1": "nx-1",
            "y1": "0",
            "x2": "nx",
            "y2": "ny"
        }
    },
    "solid": {
        "cylinder": {
            "x": "100",
            "y": "ny/2",
            "r": 12
        }
   },
   "smoke": {
        "rectangle": {
            "val": 5,
            "x1": "0",
            "y1": "ny/2-6",
            "x2": "1",
            "y2": "ny/2+6"
        }
   },

    "solver": {
  "type": "red_black_gauss_seidel",
